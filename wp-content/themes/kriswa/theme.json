{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Soft grey",
					"color": "#f5f5f7"
				},
				{
					"slug": "tint",
					"name": "Light blue",
					"color": "#e8effc"
				},
				{
					"slug": "primary",
					"name": "Brand blue",
					"color": "#1747b8"
				},
				{
					"slug": "primary-dark",
					"name": "Deep blue",
					"color": "#0f3290"
				},
				{
					"slug": "navy",
					"name": "Navy",
					"color": "#0b1b3f"
				},
				{
					"slug": "accent",
					"name": "Accent red",
					"color": "#e11d2a"
				},
				{
					"slug": "contrast",
					"name": "Text",
					"color": "#1d1d1f"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#6e6e73"
				}
			],
			"gradients": [
				{
					"slug": "hero",
					"name": "Hero",
					"gradient": "linear-gradient(180deg,#fbfbfd 0%,#f5f5f7 100%)"
				},
				{
					"slug": "cta",
					"name": "Call to action",
					"gradient": "linear-gradient(135deg,#1d1d1f 0%,#0b1b3f 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "System (SF Pro on Apple devices, Inter elsewhere)",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', Inter, 'Noto Sans Devanagari', 'Segoe UI', system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Noto Sans Devanagari",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-sans-devanagari-devanagari-wght-normal.woff2"
							],
							"unicodeRange": "U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF, U+11B00-11B09"
						}
					]
				},
				{
					"slug": "heading",
					"name": "System display",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', Inter, 'Noto Sans Devanagari', 'Segoe UI', system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)"
				},
				{
					"slug": "x-large",
					"name": "Title",
					"size": "clamp(1.9rem, 1.4rem + 1.8vw, 3rem)"
				},
				{
					"slug": "xx-large",
					"name": "Large title",
					"size": "clamp(2.4rem, 1.6rem + 3vw, 4rem)"
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "clamp(2.6rem, 1.3rem + 5.2vw, 5.5rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3rem, 2rem + 4vw, 5.5rem)"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "clamp(4rem, 3rem + 5vw, 7.5rem)"
				}
			]
		},
		"border": {
			"radius": true
		},
		"shadow": {
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 1px 2px rgba(11,27,63,.06), 0 8px 24px rgba(11,27,63,.08)"
				},
				{
					"slug": "lift",
					"name": "Lift",
					"shadow": "0 12px 40px rgba(11,27,63,.18)"
				}
			]
		},
		"custom": {
			"radius": "24px"
		}
	},
	"customTemplates": [
		{
			"name": "page-about",
			"title": "About page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-services",
			"title": "Services page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-contact",
			"title": "Contact page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-quote",
			"title": "Get a Quote page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-faq",
			"title": "FAQ page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-social",
			"title": "Social page",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "page-banner",
			"title": "Page banner",
			"area": "uncategorized"
		}
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.47"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.022em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"border": {
					"radius": "980px"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"text": "var(--wp--preset--color--primary)",
							"background": "transparent"
						},
						"border": {
							"color": "currentColor",
							"width": "2px",
							"style": "solid"
						},
						"spacing": {
							"padding": {
								"top": "calc(0.7rem - 2px)",
								"bottom": "calc(0.7rem - 2px)",
								"left": "calc(1.5rem - 2px)",
								"right": "calc(1.5rem - 2px)"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius)"
				}
			},
			"core/quote": {
				"border": {
					"width": "0 0 0 4px",
					"color": "var(--wp--preset--color--primary)",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"left": "1.25rem"
					}
				}
			}
		}
	}
}